APP_ENV=development

# Environment-specific server identity and listener settings. Keep loopback for
# local development; set a reviewed staging/private bind address on the VPS.
FIVEM_BIND_ADDRESS=127.0.0.1
FIVEM_PORT=30120
SERVER_NAME=Tarrant County RP - Development
SERVER_DESCRIPTION=Phase 1 Qbox development runtime
SERVER_TAGS=development, qbox
SERVER_MAX_CLIENTS=8

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tarrant_rp_dev
DB_USER=tarrant_rp
DB_PASSWORD=CHANGE_ME

# Used only by the local database setup helper; Qbox must never use this account.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=CHANGE_ME

FIVEM_LICENSE_KEY=CHANGE_ME
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_LOG_WEBHOOK=
TEBEX_SECRET=CHANGE_ME

# Optional runtime overrides. Windows helpers also discover these repo-relative defaults.
FXSERVER_RUN_SH=/path/to/FXServer/server/run.sh
FXSERVER_EXE=fxserver/FXServer.exe
QBOX_RESOURCES_DIR=runtime/qbox-server-data/resources
FXSERVER_CONFIG=runtime/qbox-server-data/server.cfg
TXDATA_DIR=txData
TXADMIN_BIND_ADDRESS=127.0.0.1
TXADMIN_PORT=40120
TXADMIN_URL=http://127.0.0.1:40120
